# Optional: app-wide Google OAuth Client ID for one-tap Google Drive backup.
#
# When set, the History → "Cloud backup (Google Drive)" card shows Back up /
# Restore buttons that sign the user in with your app — no per-user setup. When
# unset, the card falls back to the bring-your-own-Client-ID flow.
#
# This value is PUBLIC (embedded in the client bundle). OAuth Client IDs are not
# secrets — do NOT put a client *secret* here (none is needed for this flow).
#
# How to obtain it — see the "Google Drive backup" section in README.md.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional server-side USDA FoodData Central key for online generic-food
# searches. Keep this secret: never rename it with a NEXT_PUBLIC_ prefix.
# Obtain a key at https://fdc.nal.usda.gov/api-key-signup
USDA_FDC_API_KEY=

# Optional AI food-photo analysis. All values are server-only. Create a
# dedicated OpenAI project/key with a hard monthly spend limit before enabling.
# Production also requires the Upstash REST credentials below so per-IP and
# per-installation limits remain durable across serverless instances.
AI_FOOD_SCANNER_ENABLED=false
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
AI_FOOD_MODEL=gpt-4.1-mini
AI_SCAN_DAILY_DEVICE_LIMIT=20
AI_SCAN_HOURLY_IP_LIMIT=20
AI_MAX_IMAGE_SIZE_MB=4
# AI meal ideas follow AI_FOOD_SCANNER_ENABLED by default and reuse the same
# OpenAI project/model. Uncomment only to override that shared setting.
# AI_MEAL_RECOMMENDATIONS_ENABLED=true
AI_RECOMMENDATION_DAILY_DEVICE_LIMIT=5
AI_RECOMMENDATION_HOURLY_IP_LIMIT=10
# Optional owner-only bypass for the application AI limits. Use at least 32
# random characters (for example: openssl rand -base64 32). Never expose this
# through NEXT_PUBLIC_* or reuse an OpenAI key.
AI_SCAN_UNLIMITED_KEY=
# Production defaults to true. Set false only for local/self-hosted testing.
AI_SCAN_REQUIRE_REDIS=true

# Optional encrypted short-link sharing. Keep every value below server-only.
# Connect an Upstash Redis database through the Vercel Marketplace, then copy
# the injected REST values. Sharing stays disabled unless explicitly enabled.
SHARE_SERVICE_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Quota guard: Upstash Developer API credentials are used server-side to read
# monthly database statistics. At 80%, new links stop while existing reads stay
# available. Set SHARE_QUOTA_GUARD_ENABLED=false only if relying solely on an
# Upstash provider-level budget/free-tier hard cap.
SHARE_QUOTA_GUARD_ENABLED=true
UPSTASH_REDIS_DATABASE_ID=
UPSTASH_DEVELOPER_EMAIL=
UPSTASH_DEVELOPER_API_KEY=
SHARE_MONTHLY_COMMAND_LIMIT=500000
SHARE_QUOTA_THRESHOLD=0.8
SHARE_TTL_SECONDS=2592000
